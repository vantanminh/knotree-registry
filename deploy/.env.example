POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://registry:replace-with-a-long-random-password@postgres:5432/registry
PUBLIC_REGISTRY_URL=https://registry.knotree.com
CONTROL_PLANE_ORIGINS=https://registry.knotree.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Use R2 for multi-host durability. Keep the bucket private.
STORAGE_BACKEND=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=knotree-registry
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
