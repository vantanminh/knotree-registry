APP_ENV=development
BIND_ADDR=127.0.0.1:8080
PUBLIC_REGISTRY_URL=http://localhost:8080
DATABASE_URL=postgres://registry:registry@localhost:5432/registry
DATABASE_MAX_CONNECTIONS=10
REQUIRE_DATABASE=true
STORAGE_BACKEND=r2
STORAGE_ROOT=./data/objects
REQUEST_BODY_LIMIT_BYTES=4194304

# R2 settings are intentionally names only; never commit credential values.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=knotree-registry
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
